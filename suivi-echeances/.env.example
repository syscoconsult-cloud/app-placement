# Copier en .env et compléter. Ne jamais versionner le fichier .env.
# Une configuration par application : « france » (connectée à Pennylane) ou « benin ».
EDITION=france
SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
# Base PostgreSQL gérée (sauvegardée par l'hébergeur) ; sans elle, fichier SQLite local.
# DATABASE=postgresql://utilisateur:mot-de-passe@hote:5432/echeances
DATABASE=/donnees/echeances.sqlite3
# Premier compte administrateur, créé au démarrage s'il n'en existe aucun.
# Supprimez ADMIN_MOT_DE_PASSE après la première connexion.
ADMIN_EMAIL=
ADMIN_NOM=
ADMIN_MOT_DE_PASSE=
URL_APPLICATION=https://echeances.votre-cabinet.fr

# Pennylane — édition France uniquement (jeton API du cabinet, à créer dans les paramètres du cabinet)
PENNYLANE_TOKEN=
PENNYLANE_BASE_URL=https://app.pennylane.com/api/external/v2
PENNYLANE_FIRM_ID=
PENNYLANE_OWN_COMPANY_ID=
# Facultatif : chemins des services si différents des valeurs par défaut (JSON)
# PENNYLANE_ENDPOINTS={"tva": "/companies/{company_id}/vat_returns"}

# Envoi des alertes (serveur SMTP hébergé en France, ex. OVHcloud, Scaleway TEM)
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=echeances@votre-cabinet.fr
