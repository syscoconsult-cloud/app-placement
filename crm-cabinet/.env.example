# Copiez ce fichier en .env puis remplacez les valeurs.
# Base de données locale (un seul fichier sur votre ordinateur)
DATABASE_URL="file:../data/crm.db"

# Clé secrète des sessions : générez-la avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="a-remplacer-par-une-longue-chaine-aleatoire"

# Pas de télémétrie Next.js
NEXT_TELEMETRY_DISABLED=1
